# テスト専用 DB 接続設定
# docker-compose.test.yml の db_test サービスに対応
DB_HOSTNAME=127.0.0.1
DB_PORT=3307
DB_USER=Admin
DB_PASSWORD=password
DB_NAME=budgetdb_test
DATABASE_URL=mysql://Admin:password@127.0.0.1:3307/budgetdb_test
NODE_ENV=test
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY は秘密鍵をリポジトリに置かないため、ここには書かない。
# 統合テスト起動時に vitest.integration.config.ts が RSA 鍵ペアを生成して注入する。

# 統合テスト・E2E はログイン失敗ケースを繰り返すためレート制限を無効化する
RATE_LIMIT_DISABLED=1
