{
  "name": "budget-management-tool",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "dev:api": "pnpm --filter @budget/api run dev",
    "dev:web": "pnpm --filter web run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "turbo run format",
    "prepare": "lefthook install",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:start:test": "docker compose -f docker-compose.test.yml up -d",
    "db:stop:test": "docker compose -f docker-compose.test.yml down",
    "db:migrate:create": "pnpm --filter @budget/api run migration:create",
    "db:migrate:deploy": "pnpm --filter @budget/api run migration:run",
    "db:docs": "pnpm --filter @budget/api run db:docs",
    "db:share": "pnpm --filter @budget/api run db:share",
    "logs": "docker compose logs -f",
    "test:unit": "turbo run test:unit",
    "test:api": "turbo run test:api",
    "test:integration": "pnpm --filter @budget/api run test:integration",
    "test:e2e": "playwright test",
    "generate:openapi": "pnpm --filter @budget/api run generate:openapi",
    "generate:spec": "pnpm --filter @budget/api run generate:spec",
    "sync:tokens": "tsx --tsconfig tsconfig.scripts.json scripts/sync-tokens.ts",
    "sync:tokens:figma": "tsx --tsconfig tsconfig.scripts.json scripts/sync-tokens.ts --figma",
    "codegen": "pnpm run generate:openapi && openapi-typescript packages/api-spec/openapi.yaml -o packages/api-client/src/schema.d.ts && pnpm --filter @budget/api-client run build",
    "gen:keys": "tsx --tsconfig tsconfig.scripts.json scripts/gen-keys.ts",
    "docs:check-links": "bash scripts/check-doc-links.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "lefthook": "^2.1.5",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@^7.0.0": "^7.29.6",
      "@xmldom/xmldom@^0.8.0": "^0.8.15",
      "@xmldom/xmldom@^0.9.0": "^0.9.12",
      "baseline-browser-mapping@^2.0.0": "2.11.29",
      "brace-expansion@^1.0.0": "^1.1.21",
      "brace-expansion@^2.0.0": "^2.1.7",
      "brace-expansion@^5.0.0": "^5.0.6",
      "browserslist@^4.0.0": "^4.28.7",
      "compression@^1.0.0": "^1.8.2",
      "cross-spawn": ">=7.0.5",
      "deepmerge-ts@^7.0.0": "^8.0.2",
      "js-yaml@^3.0.0": "^3.15.0",
      "js-yaml@^4.0.0": "^4.3.2",
      "nanoid@^3.0.0": "^3.3.18",
      "postcss": ">=8.5.23",
      "shell-quote@^1.0.0": "^1.11.0",
      "tar@^7.0.0": "^7.5.21",
      "tmp@^0.2.0": "^0.2.6",
      "undici@^6.0.0": "^6.29.1",
      "uuid@^3.0.0": "^11.1.1",
      "uuid@^7.0.0": "^11.1.1",
      "uuid@^9.0.0": "^11.1.1"
    },
    "onlyBuiltDependencies": [
      "lefthook",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
